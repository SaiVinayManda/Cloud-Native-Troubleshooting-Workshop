{
  "name": "cloud-native-troubleshooting-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A dependency-free storefront and catalog for a Docker and Kubernetes troubleshooting workshop",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-config.mjs",
    "capture": "node scripts/capture-walkthrough.mjs",
    "verify:media": "node scripts/verify-media.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "yaml": "^2.9.1"
  }
}
